.header{position:relative;z-index:20;color:#fff;background:linear-gradient(135deg,#05a65d,#10bc70)}.status{height:52rpx;display:flex;align-items:flex-end;justify-content:space-between;padding:0 28rpx 7rpx;font-size:23rpx;font-weight:600}.signals{font-size:18rpx;letter-spacing:2rpx}.nav{height:88rpx;display:grid;grid-template-columns:110rpx 1fr 110rpx;align-items:center}.side{height:100%;display:flex;align-items:center;padding-left:28rpx;font-size:24rpx}.side.right{justify-content:flex-end;padding:0 28rpx 0 0}.back{font-family:Arial;font-size:68rpx;font-weight:300;line-height:1}.title{text-align:center;font-size:34rpx;font-weight:700}.header-light{color:#101828;background:#fff}.header-light .status{color:#101828}
