.stepbar{display:flex;justify-content:space-between;margin-bottom:30rpx}.step-item{position:relative;flex:1;text-align:center;color:#667085;font-size:22rpx}.step-dot{position:relative;z-index:2;width:56rpx;height:56rpx;display:flex;align-items:center;justify-content:center;margin:0 auto 8rpx;border-radius:50%;color:#fff;background:#D0D5DD}.step-item.done .step-dot,.step-item.current .step-dot{background:#16B364}.step-line{position:absolute;z-index:1;height:4rpx;top:27rpx;left:58%;right:-42%;background:#D0D5DD}.step-item.done .step-line{background:#16B364}
