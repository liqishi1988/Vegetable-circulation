<app-header title="到货验收" />
<view class="page"><product-card product="{{product}}"/><view class="section-title">现场照片　<text class="muted">3/6</text></view><view class="photo-grid"><view class="upload" bindtap="addPhoto">📷<text>添加照片</text></view><view class="photo-tile"><image src="/assets/evidence-crates.png" mode="aspectFill"/></view><view class="photo-tile"><image src="/assets/evidence-scale.png" mode="aspectFill"/></view></view><view class="card"><view class="section-title">验收信息</view><view class="field"><text class="field-label">到货净重</text><input class="input" value="1980"/><text>斤</text></view><view class="field"><text class="field-label">等级检查</text><picker range="{{grades}}"><view class="input">符合　⌄</view></picker></view><view class="field"><text class="field-label">包装情况</text><picker range="{{packages}}"><view class="input">完好　⌄</view></picker></view><view class="field"><text class="field-label">损耗率</text><input class="input" value="1.0"/><text>%</text></view></view><view class="actions"><view class="card {{mode==='pass'?'selected-card':''}}" data-mode="pass" bindtap="selectMode"><view class="price-sm">✓ 验收通过</view><text class="muted">货物与订单一致</text></view><view class="card {{mode==='issue'?'selected-card':''}}" data-mode="issue" bindtap="selectMode"><view class="price-sm">! 发现问题</view><text class="muted">存在质量、数量等问题</text></view></view><button class="btn btn-primary btn-block" bindtap="confirm">确认验收</button></view>
