.tracking-page{min-height:100vh;background:#f6f8f7}.route-map{width:100%;height:640rpx;display:block}.tracking-content{position:relative;margin-top:-18rpx;padding:0 22rpx 28rpx}.status-card{border-radius:26rpx 26rpx 18rpx 18rpx}.truck-icon{width:68rpx;height:68rpx;display:flex;align-items:center;justify-content:center;border-radius:16rpx;color:#fff;background:#08b468}.status-title{color:#07985b;font-size:38rpx;font-weight:800}.progress{position:relative;height:16rpx;margin:28rpx 0 12rpx;border-radius:10rpx;background:#d7dce1}.progress view{width:60%;height:100%;border-radius:10rpx;background:#09ad65}.progress text{position:absolute;left:57%;top:-24rpx;color:#09ad65;font-size:42rpx}.distance .strong{color:#08a760;font-size:34rpx;font-weight:700}.route-points{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;margin-top:25rpx}.route-points>view{display:flex;gap:10rpx}.route-points text{display:block;font-size:23rpx}.route-points .strong{font-weight:700}.green{color:#0bad65}.red{color:#ff3b20}.driver{display:flex;align-items:center;gap:18rpx}.driver>image{width:92rpx;height:92rpx;border-radius:50%}.driver-name{font-size:31rpx;font-weight:700}.arrow{font-size:48rpx;color:#667085}
