<app-header title="我的订单" back="{{false}}" action="⌕" />
<view class="tabs"><text wx:for="{{tabs}}" wx:key="*this" class="tab {{active===item?'active':''}}" data-value="{{item}}" bindtap="select">{{item}}</text></view>
<view class="page"><view wx:for="{{products}}" wx:key="id" class="card order-card" data-index="{{index}}" bindtap="open"><view class="seller-line row"><image src="/assets/farmer-avatar.png"/><text class="grow">寿光绿源蔬菜基地 ›</text><text class="tag {{index===1?'tag-blue':'tag-orange'}}">{{statuses[index]}}</text></view><view class="order-product row"><image src="{{item.image}}" mode="aspectFill"/><view class="grow"><view class="manage-name">{{item.name}}</view><text class="muted">规格：{{item.qty}}/车</text><view class="price-sm">¥{{index===1?'1.60':'2.00'}}/斤</view></view><view class="order-qty"><view>{{2000+index*500}} 斤</view><text class="muted">总金额 ¥{{4000+index*400}}.00</text></view></view><view class="muted">订单号：DD2024101{{7-index}}000{{index+1}}</view><view class="muted">下单时间：2024-10-{{17-index}} 10:30</view><view class="actions"><button class="btn btn-secondary btn-sm" catchtap="call">☎ 联系卖家</button><button class="btn {{index===2?'btn-accent':'btn-secondary'}} btn-sm">{{index===2?'▣ 去验收':'🚚 查看物流'}}</button></view></view></view>
