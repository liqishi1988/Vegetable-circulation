.me-page{padding-top:0}.profile-hero{position:relative;overflow:hidden;margin:0 -22rpx;padding:42rpx 36rpx 80rpx;color:#fff}.profile-bg,.profile-mask{position:absolute;inset:0;width:100%;height:100%}.profile-mask{background:rgba(0,165,92,.76)}.profile-content{position:relative;z-index:2}.profile-avatar{width:132rpx;height:132rpx;border-radius:50%;border:5rpx solid #fff}.profile-name{font-size:38rpx;font-weight:700;margin-bottom:6rpx}.profile-tags{display:flex;gap:10rpx;margin-top:15rpx}.profile-tags text{padding:6rpx 12rpx;border-radius:7rpx;color:#087443;background:#e8fff2;font-size:21rpx}.profile-arrow{font-size:55rpx}.profile-metrics{display:grid;grid-template-columns:repeat(3,1fr);margin-top:-42rpx;padding:28rpx 10rpx}.profile-metrics .metric{border-right:1rpx solid #e4e7ec}.profile-metrics .metric:last-child{border:0}.profile-value{display:block;color:#073f2b;font-size:42rpx;font-weight:800}.unit{font-size:22rpx}.menu-list{overflow:hidden;border-radius:18rpx;background:#fff;box-shadow:0 4rpx 16rpx rgba(16,24,40,.04)}.menu-row{min-height:112rpx;display:flex;align-items:center;gap:20rpx;padding:0 24rpx;border-bottom:1rpx solid #eaecf0}.menu-icon{width:72rpx;height:72rpx;display:flex;align-items:center;justify-content:center;border-radius:14rpx;color:#fff;font-size:36rpx;background:#28b875}.tone-1{background:#ff781a}.tone-2{background:#2f80ed}.tone-3{background:#0ca85f}.tone-4{background:#ffab1a}.tone-5{background:#2d9cdb}.menu-title{font-size:30rpx;font-weight:700}.menu-arrow{font-size:44rpx;color:#475467}
