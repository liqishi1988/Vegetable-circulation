<app-header title="经营主体认证" />
<view class="page"><step-bar items="{{steps}}" current="1"/><view class="card"><view class="field"><text class="field-label">主体类型</text><view class="input">合作社　⌄</view></view><view class="field"><text class="field-label">主体名称</text><input class="input" placeholder="请输入合作社全称"/></view><view class="field"><text class="field-label">统一社会信用代码</text><input class="input" placeholder="请输入18位统一社会信用代码"/></view><view class="field"><text class="field-label">负责人姓名</text><input class="input" placeholder="请输入负责人真实姓名"/></view></view><view class="card"><view class="between"><view class="section-title">证件资料</view><text class="muted">请上传清晰、完整的证件照片</text></view><view class="grid-2 credential"><view class="upload" bindtap="upload"><view class="license">营业执照</view><text>📷 营业执照</text><text class="tiny">支持JPG、PNG格式</text></view><view class="upload" bindtap="upload"><text style="font-size:70rpx">🪪</text><text>📷 负责人身份证</text><text class="tiny">支持JPG、PNG格式</text></view></view></view><button class="btn btn-primary btn-block" bindtap="next">提交认证</button></view>
