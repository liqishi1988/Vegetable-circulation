<app-header title="基地认证" />
<view class="page"><step-bar items="{{steps}}" current="1"/><view class="card"><view class="field"><text class="field-label">基地位置</text><view class="grow"><image class="base-map-image" src="/assets/base-map.png" mode="aspectFill"/><text>● 山东省寿光市　›</text></view></view><view class="field"><text class="field-label">基地名称</text><input class="input" placeholder="请输入基地名称"/></view><view class="field"><text class="field-label">种植面积</text><input class="input" value="120"/><text>亩</text></view><view class="field"><text class="field-label">主营品类</text><view class="input">西红柿、黄瓜　›</view></view></view><view class="between"><view class="section-title">基地现场照片</view><text class="muted">请上传真实的基地照片</text></view><view class="base-photo-grid"><view><image src="/assets/base-entrance.png" mode="aspectFill"/><text>基地入口</text></view><view><image src="/assets/base-greenhouse.png" mode="aspectFill"/><text>种植现场</text></view><view><image src="/assets/base-loading.png" mode="aspectFill"/><text>仓储装车区</text></view></view><button class="btn btn-primary btn-block" bindtap="submit">提交核验</button></view>
