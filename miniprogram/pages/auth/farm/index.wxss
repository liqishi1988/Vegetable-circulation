.base-map-image{width:100%;height:220rpx;border-radius:14rpx;display:block;margin-bottom:15rpx}.base-photo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx}.base-photo-grid>view{overflow:hidden;border:1rpx solid #e4e7ec;border-radius:12rpx;background:#fff;text-align:center}.base-photo-grid image{width:100%;height:210rpx;display:block}.base-photo-grid text{display:block;padding:12rpx 4rpx;font-size:23rpx}
