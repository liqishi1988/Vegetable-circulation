.detail-page{min-height:100vh;background:#f6f8f7}.detail-cover{position:relative;height:390rpx}.detail-cover image{width:100%;height:100%;display:block}.detail-cover>text{position:absolute;right:22rpx;bottom:22rpx;padding:5rpx 13rpx;border-radius:20rpx;color:#fff;background:rgba(0,0,0,.65);font-size:22rpx}.detail-body{position:relative;margin-top:-18rpx;padding:0 18rpx 24rpx}.product-info{border-radius:24rpx 24rpx 18rpx 18rpx}.detail-name{font-size:37rpx;font-weight:800}.price-unit{font-size:30rpx}.info-meta{display:flex;justify-content:space-between;color:#667085;font-size:25rpx;margin-top:14rpx}.spec-list{margin-top:22rpx;border-top:1rpx solid #eaecf0}.spec-list>view{display:flex;justify-content:space-between;padding:20rpx 0;border-bottom:1rpx solid #eaecf0;font-size:25rpx}.spec-list>view text:last-child{color:#475467}.store-row{display:flex;align-items:center;gap:20rpx}.store-row>image{width:92rpx;height:92rpx;border-radius:50%;border:3rpx solid #d8f4e5}.store-name{font-size:30rpx;font-weight:700;margin-bottom:5rpx}.arrow{font-size:48rpx;color:#475467}.detail-actions{display:grid;grid-template-columns:1fr 1.35fr;gap:16rpx;position:sticky;bottom:0;background:#fff;padding:16rpx 0 calc(10rpx + env(safe-area-inset-bottom))}
