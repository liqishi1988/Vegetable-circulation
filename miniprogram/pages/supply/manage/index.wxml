<app-header title="我的货源" action="•••" />
<view class="tabs"><text wx:for="{{tabs}}" wx:key="key" class="tab {{active===item.key?'active':''}}" data-key="{{item.key}}" bindtap="select">{{item.label}}</text></view><view class="page"><view wx:for="{{products}}" wx:key="id" class="card"><view class="row"><image class="manage-photo" src="{{item.image}}" mode="aspectFill"/><view class="grow"><view class="between"><text class="manage-name">{{item.name}}</text><text class="tag tag-green">✓ 在售</text></view><view class="price">¥{{item.price}}/斤</view><text>剩余 {{index===0?'6,500':'3,200'}} 斤</text></view></view><view class="manage-meta"><text>● 山东 · 寿光</text><text>▣ {{item.qty}}</text><text>🚚 今天可装车</text></view><view class="three-actions"><button class="btn btn-secondary btn-sm" bindtap="edit">✎ 改价</button><button class="btn btn-secondary btn-sm" bindtap="stock">▣ 补库存</button><button class="btn btn-accent btn-sm" bindtap="offline">⊙ 下架</button></view></view><button class="btn btn-primary btn-block" bindtap="publish">＋ 发布现货</button></view>
