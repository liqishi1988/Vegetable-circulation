<app-header title="编辑货源" action="•••" />
<view class="page"><view class="between"><view class="section-title">货源照片</view><text class="muted">3/6</text></view><view class="photo-grid"><view class="photo-tile"><image src="/assets/tomato.png" mode="aspectFill"/><text class="photo-remove">×</text></view><view class="photo-tile"><image src="/assets/loading-crates.png" mode="aspectFill"/><text class="photo-remove">×</text></view><view class="upload" bindtap="upload">📷<text>添加照片</text></view></view><view class="card"><view class="field"><text class="field-label">品类</text><view class="row grow"><image style="width:70rpx;height:60rpx;border-radius:8rpx" src="/assets/tomato.png"/><text class="strong">西红柿</text></view><text>›</text></view><view class="field"><text class="field-label">等级</text><view class="input">一级　⌄</view></view><view class="field"><text class="field-label">可售数量</text><input class="input" value="6500"/><text>斤</text></view><view class="field"><text class="field-label">单价</text><input class="input" value="2.10"/><text>元/斤</text></view><view class="field"><text class="field-label">最低起订量</text><input class="input" value="1000"/><text>斤</text></view><view class="field"><text class="field-label">装车时间</text><view class="input">今天可装车　▣</view></view><view class="field"><text class="field-label">货源说明</text><textarea class="textarea" value="自家基地种植，品质好，口感鲜美，可长期稳定供货。" maxlength="200"/></view></view><view class="actions"><button class="btn btn-accent" bindtap="offline">▣ 下架货源</button><button class="btn btn-primary" bindtap="save">保存修改</button></view></view>
