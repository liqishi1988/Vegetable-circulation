.login-page{min-height:100vh;background:#fff}.login-hero{width:100%;height:700rpx;display:block}.login-panel{position:relative;margin-top:-30rpx;padding:26rpx 28rpx 36rpx;background:#fff;border-radius:28rpx 28rpx 0 0}.phone-entry{display:flex;align-items:center;gap:20rpx;padding:22rpx 24rpx;border-radius:20rpx;background:linear-gradient(90deg,#effbf5,#f8fcfa)}.phone-icon{width:84rpx;height:84rpx;border-radius:16rpx;display:flex;align-items:center;justify-content:center;color:#fff;font-size:42rpx;background:linear-gradient(135deg,#12a864,#02c47b)}.entry-title{font-weight:700;font-size:32rpx}.entry-sub,.role-sub{color:#7c8490;font-size:25rpx;line-height:1.55}.arrow{font-size:52rpx;color:#475467}.section-label{font-size:30rpx;font-weight:700;margin:28rpx 0 18rpx;padding-left:16rpx;border-left:7rpx solid #0bb66a}.role{display:flex;align-items:center;min-height:164rpx;padding:20rpx 24rpx;margin-bottom:18rpx;border:3rpx solid transparent;border-radius:22rpx}.role.farmer{background:linear-gradient(90deg,#ecfbf4,#f7fcf9)}.role.buyer{background:linear-gradient(90deg,#fff4e9,#fffaf5)}.role-active{border-color:#0bb66a!important}.role-illustration{width:150rpx;font-size:86rpx}.role-title{font-size:34rpx;font-weight:700;color:#075a38}.role-title.orange,.role-arrow.orange{color:#ff5b12}.role-arrow{font-size:55rpx;color:#06985a}.wechat-btn,.skip-btn{height:92rpx;display:flex;align-items:center;justify-content:center;border-radius:14rpx;font-size:32rpx;font-weight:700}.wechat-btn{color:#fff;background:linear-gradient(90deg,#11a95f,#08bf70)}.wechat-btn::before{content:'●';margin-right:15rpx}.wechat-btn::after,.skip-btn::after{border:0}.skip-btn{height:72rpx;margin-top:12rpx;color:#087443;background:#fff}.agreement{text-align:center;color:#667085;font-size:23rpx;margin-top:8rpx}.agreement text{color:#00a865}
