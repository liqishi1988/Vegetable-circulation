.store-page{min-height:100vh;background:#f6f8f7}.store-banner{width:100%;height:330rpx;display:block}.store-content{padding:0 22rpx 30rpx}.store-metrics{margin-top:-18rpx;position:relative}.metric-value small{font-size:22rpx}.mini-product{display:flex;align-items:center;gap:20rpx;padding:12rpx;margin-bottom:14rpx;border:1rpx solid #e9edf0;border-radius:16rpx;background:#fff}.mini-product>image{width:145rpx;height:122rpx;border-radius:14rpx}.mini-name{font-weight:700}.arrow{font-size:44rpx;color:#667085}.archive{display:grid;grid-template-columns:repeat(3,1fr);padding:20rpx 8rpx}.archive>view{text-align:center;border-right:1rpx solid #e6e9ed}.archive>view:last-child{border:0}.archive text,.archive b{display:block;font-size:22rpx}.archive>view text:first-child{font-size:40rpx}.archive b{font-size:25rpx;margin-top:4rpx}
