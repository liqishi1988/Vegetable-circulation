.settings-profile{display:flex;align-items:center;gap:22rpx}.settings-profile image{width:110rpx;height:110rpx;border-radius:50%}.settings-name{font-size:34rpx;font-weight:700;margin-bottom:8rpx}.arrow{font-size:42rpx;color:#475467}.security{display:flex;align-items:center;gap:18rpx;padding:20rpx 24rpx;margin-bottom:22rpx;border-radius:16rpx;background:#ecfbf4;color:#087443}.shield{width:56rpx;height:56rpx;display:flex;align-items:center;justify-content:center;border-radius:14rpx;color:#fff;background:#08a861}.security .grow text{display:block}.security .grow text:first-child{font-weight:700}.security .grow text:last-child{color:#667085;font-size:23rpx}.settings-list{overflow:hidden;border-radius:18rpx;background:#fff}.settings-row{min-height:100rpx;display:flex;align-items:center;gap:18rpx;padding:0 22rpx;border-bottom:1rpx solid #eaecf0}.settings-icon{width:55rpx;height:55rpx;display:flex;align-items:center;justify-content:center;border-radius:12rpx;color:#fff;background:#0bad65}.tone-1{background:#ff6918}.tone-2,.tone-3{background:#1d7bf2}.tone-4{background:#ff431f}.row-title{font-weight:700}.settings-row>.muted{font-size:22rpx}.version{text-align:center;color:#98a2b3;font-size:22rpx;line-height:1.55;margin:28rpx}.logout{height:90rpx;display:flex;align-items:center;justify-content:center;border:2rpx solid #ff4b1e;border-radius:14rpx;color:#ff4b1e;background:#fff;font-weight:700}.logout::after{border:0}
