.publish-page{min-height:100vh;padding:32rpx 28rpx;background:#fff}.publish-photos{margin-top:38rpx}.publish-photos .photo-tile,.add-photo{height:210rpx}.add-photo text:first-child{font-size:52rpx;color:#09a962}.form-card{margin-top:42rpx;border:1rpx solid #e6e9ed;border-radius:18rpx;overflow:hidden}.form-row{min-height:122rpx;display:grid;grid-template-columns:185rpx 1fr;align-items:center;padding:0 25rpx;border-bottom:1rpx solid #e6e9ed;font-size:30rpx;font-weight:700}.form-row:last-child{border:0}.form-value{display:flex;align-items:center;justify-content:flex-end;gap:18rpx;text-align:right;font-weight:400}.form-value input{text-align:right}.publish-next{margin-top:90rpx}
