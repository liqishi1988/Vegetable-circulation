.message-tabs{display:grid;grid-template-columns:1fr 1fr;background:#fff;border-bottom:1rpx solid #eee}.message-tab{position:relative;height:88rpx;display:flex;align-items:center;justify-content:center;color:#667085;font-size:31rpx;font-weight:600}.message-tab.active{color:#087443}.message-tab.active::after{content:"";position:absolute;bottom:0;left:23%;right:23%;height:6rpx;border-radius:6rpx;background:#16b364}.badge{position:absolute;top:12rpx;margin-left:145rpx;width:34rpx;height:34rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;color:#fff;background:#f04438;font-size:20rpx}.message-page{padding:18rpx 20rpx}.message-row{display:flex;align-items:center;gap:18rpx;min-height:150rpx;margin-bottom:16rpx;padding:20rpx;border-radius:20rpx;background:#fff;box-shadow:0 4rpx 16rpx rgba(16,24,40,.04)}.message-icon{width:82rpx;height:82rpx;display:flex;align-items:center;justify-content:center;flex:none;border-radius:18rpx;color:#fff;background:#ff710f;font-size:39rpx}.tone-1{background:#11a85a}.tone-2{background:#2187ed}.tone-3{background:#ff710f}.message-head{display:flex;align-items:center;justify-content:space-between}.message-head text:first-child{font-size:31rpx;font-weight:700}.message-head text:last-child{color:#98a2b3;font-size:23rpx}.message-desc,.message-detail{margin-top:5rpx;color:#667085;font-size:24rpx}.unread{align-self:flex-start;margin-top:18rpx;color:#f04438;font-size:18rpx}.chevron{color:#667085;font-size:42rpx}
