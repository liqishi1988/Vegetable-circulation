<app-header title="消息" back="{{false}}" />
<view class="message-tabs"><view wx:for="{{tabs}}" wx:key="*this" class="message-tab {{active===item?'active':''}}" data-value="{{item}}" bindtap="select">{{item}}<text wx:if="{{index===0}}" class="badge">3</text></view></view>
<view class="message-page"><view wx:for="{{rows}}" wx:key="title" class="message-row" data-url="{{item.url}}" bindtap="open"><text class="message-icon tone-{{index}}">{{item.icon}}</text><view class="grow"><view class="message-head"><text>{{item.title}}</text><text>{{item.time}}</text></view><view class="message-desc">{{item.desc}}</view><view class="message-detail">{{index===0?'西红柿 · 一级，预计2000斤':index===1?'西红柿 · 一级 2000斤 ¥2.00/斤':index===2?'订单 DD202410180001':'货物已到达目的地，请安排验收'}}</view></view><text class="unread">●</text><text class="chevron">›</text></view></view>
