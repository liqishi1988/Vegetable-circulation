.driver-page{padding:18rpx 20rpx 28rpx}.task-status{display:flex;align-items:center;gap:18rpx;padding:20rpx;margin-bottom:18rpx;border-radius:20rpx;background:#fff3e9;color:#e84b0e}.case-icon{width:72rpx;height:72rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;color:#fff;background:#ff5b11;font-size:36rpx}.task-status .grow view{font-size:34rpx;font-weight:700}.task-status .grow text{color:#667085;font-size:23rpx}.arrow{font-size:40rpx}.route-card,.goods-card,.flow-card{padding:18rpx;border-radius:20rpx;background:#fff;box-shadow:0 3rpx 14rpx rgba(16,24,40,.04)}.route-card{margin-bottom:18rpx}.route-point{position:relative;display:flex;gap:16rpx;padding:12rpx 0 26rpx}.route-point:first-child{border-bottom:1rpx solid #eee}.route-point .pin{color:#10ad5d;font-size:35rpx}.route-point.delivery .pin{color:#f04438}.route-point .grow{display:flex;flex-direction:column}.route-point .grow view{font-weight:700}.route-point .grow text{margin-top:5rpx;color:#667085;font-size:23rpx}.route-point button{align-self:flex-start;margin:0;padding:0 17rpx;height:54rpx;line-height:54rpx;border:0;border-radius:10rpx;color:#1677d2;background:#eaf5ff;font-size:23rpx}.route-point button::after{border:0}.goods-card{display:flex;align-items:center;gap:18rpx}.goods-card image{width:128rpx;height:100rpx;border-radius:14rpx}.goods-name{font-size:28rpx;font-weight:700}.goods-weight{margin-top:8rpx;color:#f04b17}.goods-weight text{font-size:40rpx;font-weight:700}.deadline{padding:22rpx 8rpx;border-bottom:1rpx solid #eee;font-size:26rpx}.deadline text{float:right;color:#f04b17}.flow-title{margin:20rpx 4rpx 12rpx;font-size:30rpx;font-weight:700}.flow-title text{color:#667085;font-size:25rpx;font-weight:400}.flow-row{display:flex;align-items:center;gap:18rpx;padding:15rpx 0}.flow-row>text:first-child{width:56rpx;height:56rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;color:#fff;background:#98a2b3}.flow-row.current{color:#087443;background:#effbf4}.flow-row.current>text:first-child{background:#16b364}.flow-row>view{flex:1}.flow-row>view view{font-weight:700}.flow-row>view text{color:#667085;font-size:22rpx}.driver-action{height:92rpx;margin-top:22rpx;border:0;border-radius:14rpx;color:#fff;background:#12b76a;font-size:31rpx;font-weight:700}.driver-action::after{border:0}
