.trend-product{width:130rpx;height:110rpx;border-radius:12rpx}.trend-tabs{display:grid;grid-template-columns:repeat(3,1fr);margin:-22rpx -22rpx 20rpx;background:#f8faf9}.trend-tabs text{text-align:center;padding:18rpx;color:#667085}.trend-tabs .active{color:#079c5c;border-bottom:5rpx solid #0bad65;font-weight:700}.trend-chart{height:280rpx;position:relative;margin-top:20rpx;border-left:1rpx solid #E4E7EC;border-bottom:1rpx solid #E4E7EC;background:repeating-linear-gradient(to bottom,#fff 0,#fff 55rpx,#edf0f2 56rpx)}.trend-line{position:absolute;left:20rpx;right:20rpx;top:130rpx;height:7rpx;border-radius:8rpx;transform:rotate(-7deg);background:linear-gradient(90deg,#F79009,#16B364)}.trend-dots{position:absolute;inset:0;display:flex;align-items:center;justify-content:space-around;color:#FF6B22}.x-axis{display:flex;justify-content:space-between;margin-top:8rpx;color:#667085;font-size:18rpx}
