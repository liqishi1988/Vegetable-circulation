.filter-bar{position:sticky;top:0;z-index:5;display:grid;grid-template-columns:repeat(4,1fr);height:92rpx;background:#fff;border-bottom:1rpx solid #edf0ee}.filter-item{display:flex;align-items:center;justify-content:center;gap:8rpx;font-size:27rpx;color:#344054}.filter-item.active{color:#087443;font-weight:700}.supply-page{padding:18rpx 20rpx 30rpx}.supply-card{padding:18rpx;margin-bottom:18rpx;border-radius:22rpx;background:#fff;box-shadow:0 4rpx 18rpx rgba(16,24,40,.05)}.supply-main{display:flex;gap:22rpx}.supply-photo{width:218rpx;height:185rpx;flex:none;border-radius:17rpx}.supply-info{position:relative;flex:1;min-width:0}.supply-name{font-size:34rpx;font-weight:700}.supply-price{margin:8rpx 0;color:#ff4d17;font-size:42rpx;font-weight:700}.supply-price text{font-size:25rpx}.verified{position:absolute;right:0;top:52rpx;padding:7rpx 12rpx;border-radius:24rpx;color:#087443;background:#e8f8f0;font-size:21rpx}.supply-meta{margin-top:18rpx;color:#667085;font-size:22rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.seller-line{display:flex;align-items:center;gap:14rpx;margin-top:14rpx;padding-top:14rpx;border-top:1rpx solid #f0f2f1;font-size:24rpx}.seller-line image{width:48rpx;height:48rpx;border-radius:50%}.quote-button{width:156rpx;height:70rpx;display:flex;align-items:center;justify-content:center;margin:0;border:0;border-radius:36rpx;color:#fff;background:#10ad5d;font-size:29rpx;font-weight:700}.quote-button::after{border:0}
