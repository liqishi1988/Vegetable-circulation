.market-page{min-height:100vh;background:#fff}.market-hero{position:relative;width:100%;height:462rpx;overflow:hidden;background:#e7f7ed}.market-hero image{width:100%;height:100%;display:block}.market-content{padding:22rpx 28rpx 36rpx}.buyer-seller{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.trade-entry{height:132rpx;display:flex;align-items:center;gap:18rpx;padding:0 28rpx;border-radius:20rpx;color:#fff}.trade-entry.buy{background:linear-gradient(135deg,#13ad65,#07c978)}.trade-entry.sell{background:linear-gradient(135deg,#ff801b,#ff5c18)}.entry-icon{font-size:52rpx}.entry-main{font-size:32rpx;font-weight:700}.entry-main.dark{color:#17202a}.entry-desc{font-size:22rpx;margin-top:6rpx}.entry-desc.gray{color:#7c8490}.demand-entry{height:116rpx;display:flex;align-items:center;gap:22rpx;margin-top:18rpx;padding:0 26rpx;border-radius:18rpx;background:linear-gradient(90deg,#edf9f3,#f6fbf8)}.demand-icon{width:66rpx;height:66rpx;display:flex;align-items:center;justify-content:center;border-radius:12rpx;background:#28b875;color:#fff;font-size:40rpx}.circle-arrow{width:52rpx;height:52rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;color:#08a662;background:#daf5e7;font-size:40rpx}.title-row{display:flex;align-items:center;justify-content:space-between;margin:28rpx 0 16rpx;color:#7c8490;font-size:24rpx}.section-heading{padding-left:14rpx;border-left:7rpx solid #0db469;color:#1d2939;font-size:32rpx;font-weight:700}.quote-grid,.hot-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16rpx}.quote-card{position:relative;height:145rpx;padding:18rpx 15rpx;overflow:hidden;border-radius:14rpx;background:#f8faf9}.quote-card>text{display:block;position:relative;z-index:2}.quote-card image{position:absolute;right:-5rpx;bottom:-8rpx;width:110rpx;height:72rpx;border-radius:50% 0 0 0}.quote-price{color:#ff5b16;font-size:26rpx;font-weight:700;margin-top:4rpx}.quote-price small{font-size:18rpx}.rise{color:#ff4d1a;font-size:20rpx}.fall{color:#05a85f;font-size:20rpx}.hot-card{font-size:24rpx;font-weight:600}.hot-card image{width:100%;height:120rpx;border-radius:12rpx;display:block;margin-bottom:8rpx}.hot-card text{display:block;color:#ff5b16;font-size:25rpx;margin-top:4rpx}
