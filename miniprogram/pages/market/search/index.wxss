.search-page{min-height:100vh;padding:18rpx 22rpx 120rpx;background:#f6f8f7}.search-box{height:82rpx;display:flex;align-items:center;gap:14rpx;padding-left:22rpx;border-radius:16rpx;background:#fff}.search-box>text:first-child{font-size:42rpx}.search-box input{flex:1}.search-box .clear{width:34rpx;height:34rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;color:#fff;background:#98a2b3}.search-box button{height:82rpx;margin:0;padding:0 34rpx;border-radius:0 16rpx 16rpx 0;color:#fff;background:#0aad64;font-size:28rpx;font-weight:700}.search-box button::after{border:0}.search-section,.filter-panel{margin-top:22rpx;padding:20rpx;border-radius:18rpx;background:#fff}.search-title{display:flex;justify-content:space-between;margin-bottom:18rpx;padding-left:13rpx;border-left:6rpx solid #0db469;font-size:29rpx;font-weight:700}.chips{display:flex;flex-wrap:wrap;gap:14rpx}.search-chip{padding:14rpx 24rpx;border-radius:12rpx;background:#f2f4f7;color:#475467;font-size:24rpx}.search-chip.active{color:#087443;background:#dff8ea}.search-chip.hot{color:#ff5a17;background:#fff0e8}.filter-panel{padding-bottom:6rpx}.filter-row{padding:18rpx 0;border-bottom:1rpx solid #e9ecef}.filter-row:last-child{border:0}.filter-label{display:flex;align-items:center;gap:14rpx;font-weight:700}.filter-icon{width:42rpx;height:42rpx;display:flex;align-items:center;justify-content:center;border:3rpx solid #0aad64;border-radius:50%;color:#0aad64}.filter-chips{margin:15rpx 0 0 58rpx}.search-actions{position:fixed;left:0;right:0;bottom:0;display:grid;grid-template-columns:1fr 1.7fr;gap:14rpx;padding:15rpx 22rpx calc(15rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #e4e7ec}
